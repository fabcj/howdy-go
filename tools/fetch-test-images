#!/bin/sh
# Downloads public domain portraits (NASA photos on Wikimedia Commons) for
# the dlib parity test, checked against pinned hashes. They stay outside the
# repo.
#
#   tools/fetch-test-images [dir]
set -eu

dir=${1:-${XDG_CACHE_HOME:-$HOME/.cache}/howdy-go/testdata}
mkdir -p "$dir"
base=https://upload.wikimedia.org/wikipedia/commons

# sha256, path on Commons, local name
while read -r sum path name; do
	out=$dir/$name
	if [ ! -f "$out" ] || ! echo "$sum  $out" | sha256sum -c --status; then
		curl -sSf --max-time 120 -A 'howdy-go-test-fetch' -o "$out.part" "$base/$path"
		if ! echo "$sum  $out.part" | sha256sum -c --status; then
			rm -f "$out.part"
			echo "fetch-test-images: $name doesn't match its hash" >&2
			exit 1
		fi
		mv "$out.part" "$out"
	fi
	echo "$out"
done <<'LIST'
