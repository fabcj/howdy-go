#!/bin/sh
# Downloads the candidate face models tools/face-eval.py compares against
# dlib, checked against pinned hashes. They stay outside the repo.
#
#   tools/fetch-face-models [-r] [dir]
#
# Only weights whose upstream license allows redistribution are fetched by
# default. -r also fetches InsightFace's ArcFace weights, which are for
# non-commercial research only: they're the accuracy ceiling to compare
# against, never something to ship.
#
# Hashes: OpenCV Zoo's git-LFS pointers for YuNet and SFace, UniFace's
# uniface/constants.py for the rest.
set -eu

research=0
if [ "${1:-}" = -r ]; then
	research=1
	shift
fi
dir=${1:-${XDG_CACHE_HOME:-$HOME/.cache}/howdy-go/models}
mkdir -p "$dir"

zoo=https://media.githubusercontent.com/media/opencv/opencv_zoo/main/models
uf=https://github.com/yakhyo/uniface/releases/download/weights
ada=https://github.com/yakhyo/adaface-onnx/releases/download/weights
edge=https://github.com/yakhyo/edgeface-onnx/releases/download/weights

# sha256, url, local name, license
while read -r sum url name license; do
	if [ "$license" = non-commercial ] && [ $research = 0 ]; then
		continue
	fi
	out=$dir/$name
	if [ ! -f "$out" ] || ! echo "$sum  $out" | sha256sum -c --status; then
		curl -sSfL --max-time 600 -A 'howdy-go-model-fetch' -o "$out.part" "$url"
		if ! echo "$sum  $out.part" | sha256sum -c --status; then
			rm -f "$out.part"
			echo "fetch-face-models: $name doesn't match its hash" >&2
			exit 1
		fi
		mv "$out.part" "$out"
	fi
	echo "$out ($license)"
done <<LIST
