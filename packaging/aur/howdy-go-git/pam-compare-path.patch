diff --git a/howdy/src/pam/main.cc b/howdy/src/pam/main.cc
index d3af59d..75132f9 100644
--- a/howdy/src/pam/main.cc
+++ b/howdy/src/pam/main.cc
@@ -2,6 +2,7 @@
 #include <csignal>
 #include <cstdlib>
 
+#include <fcntl.h>
 #include <glob.h>
 #include <libintl.h>
 #include <pthread.h>
@@ -21,6 +22,7 @@
 #include <fstream>
 #include <functional>
 #include <future>
+#include <initializer_list>
 #include <mutex>
 #include <string>
 #include <tuple>
@@ -77,7 +79,8 @@ auto howdy_error(int status,
       break;
     default:
       conv_function(PAM_ERROR_MSG,
-                    std::string(S("Unknown error: ") + status).c_str());
+                    (std::string(S("Unknown error: ")) + std::to_string(status))
+                        .c_str());
       syslog(LOG_ERR, "Failure, unknown error %d", status);
     }
   } else if (WIFSIGNALED(status)) {
@@ -262,15 +265,48 @@ auto identify(pam_handle_t *pamh, int flags, int argc, const char **argv,
     }
   }
 
-  const char *const args[] = {PYTHON_EXECUTABLE_PATH, // NOLINT
-                              COMPARE_PROCESS_PATH, username, nullptr};
+  const bool use_binary = COMPARE_BINARY_PATH[0] != '\0';
+  const char *const python_args[] = {PYTHON_EXECUTABLE_PATH, // NOLINT
+                                     COMPARE_PROCESS_PATH, username, nullptr};
+  const char *const binary_args[] = {COMPARE_BINARY_PATH, username, // NOLINT
+                                     nullptr};
+  // A fixed environment instead of an empty one. Multithreaded OpenBLAS can
+  // livelock here, and it reads these when it loads
+  const char *const env[] = {"OPENBLAS_NUM_THREADS=1", // NOLINT
+                             "OMP_NUM_THREADS=1", nullptr};
   pid_t child_pid;
 
-  // Start the python subprocess
-  if (posix_spawnp(&child_pid, PYTHON_EXECUTABLE_PATH, nullptr, nullptr,
-                   const_cast<char *const *>(args), nullptr) != 0) {
-    syslog(LOG_ERR, "Can't spawn the howdy process: %s (%d)", strerror(errno),
-           errno);
+  // When stdout or stderr is a socket, it is a protocol channel rather than a
+  // terminal or a log: polkit's socket-activated agent helper
+  // (polkit-agent-helper@.service, StandardOutput=socket) talks to the
+  // authentication agent over it. Anything the python process prints there
+  // corrupts that protocol, and the agent fails the whole session instead of
+  // falling back to the next PAM module. Send that output to /dev/null.
+  posix_spawn_file_actions_t file_actions;
+  posix_spawn_file_actions_init(&file_actions);
+  for (int output_fd : {STDOUT_FILENO, STDERR_FILENO}) {
+    struct stat output_stat {};
+    if (fstat(output_fd, &output_stat) == 0 && S_ISSOCK(output_stat.st_mode)) {
+      posix_spawn_file_actions_addopen(&file_actions, output_fd, "/dev/null",
+                                       O_WRONLY, 0);
+    }
+  }
+
+  // Start the compare process
+  int spawn_result =
+      use_binary
+          ? posix_spawn(&child_pid, COMPARE_BINARY_PATH, &file_actions,
+                        nullptr, const_cast<char *const *>(binary_args),
+                        const_cast<char *const *>(env))
+          : posix_spawnp(&child_pid, PYTHON_EXECUTABLE_PATH, &file_actions,
+                         nullptr, const_cast<char *const *>(python_args),
+                         const_cast<char *const *>(env));
+  posix_spawn_file_actions_destroy(&file_actions);
+
+  // posix_spawnp returns the error number instead of setting errno
+  if (spawn_result != 0) {
+    syslog(LOG_ERR, "Can't spawn the howdy process: %s (%d)",
+           strerror(spawn_result), spawn_result);
     return PAM_SYSTEM_ERR;
   }
 
