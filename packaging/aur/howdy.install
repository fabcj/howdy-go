post_install() {
	echo '[SETUP] 1. Remember to set a correct video device using `sudo howdy config`'
	echo '[SETUP] 2. Add face model with `sudo howdy add`'
	echo '[SETUP] 3. Add PAM policy `auth sufficient pam_howdy.so` to e.g. top of `/etc/pam.d/system-auth` (global auth)'
	echo '[SETUP]    Keep a root shell open while you try it'
	echo '[INFO] `howdy test` shows what the camera sees in the terminal, not in a window'
	echo '[INFO] List of available video devices can be obtained with `v4l2-ctl --list-devices` from `v4l-utils` package'
	echo '[INFO] Arch Wiki page: https://wiki.archlinux.org/title/Howdy'
}
