root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

[*.{md,yml,yaml,py}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

# The patches carry whitespace of their own
[*.patch]
trim_trailing_whitespace = false
insert_final_newline = unset
